# PatchPilot server-side configuration.
# Copy to .env.local and fill in real values. Never commit .env.local.

# Provider selection: alan | openrouter | openai-compatible | demo
# - alan: Alan harness endpoint (DeepSeek V4.1 Flash, MIT open weights)
# - openrouter: hosted open models with an OpenRouter key
# - openai-compatible: any vLLM / Ollama / LM Studio / Groq / Together endpoint
# - demo: deterministic rules only, no model request
PATCHPILOT_PROVIDER=alan

# --- Alan harness (server-side only) ---------------------------------------
# Use a durable key for deployment. For local development, the Alan Code
# session exports ALAN_CODE_API_KEY and PatchPilot falls back to it when
# PATCHPILOT_PROVIDER=alan.
ALAN_API_KEY=
ALAN_MODEL=deepseek/deepseek-v4.1-flash
ALAN_BASE_URL=https://api.tryalan.ai/public/harness/v1
# Optional request header used by the Alan harness.
ALAN_CONVERSATION_ID=

# --- OpenRouter fallback (server-side only) --------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder

# --- Any OpenAI-compatible endpoint ---------------------------------------
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_LABEL=
LLM_LICENSE=
LLM_LICENSE_URL=
LLM_JSON_MODE=on

# --- Limits and safety -----------------------------------------------------
PATCHPILOT_MAX_INPUT_CHARS=60000
# Characters of submission embedded in one prompt (head is kept).
PATCHPILOT_MAX_PROMPT_CHARS=24000
# Upper bound for one model response. The Alan harness allows 32768 for this
# model; PatchPilot asks for 2400 to keep reviews concise and bounded.
PATCHPILOT_MAX_OUTPUT_TOKENS=2400
# One upstream HTTP attempt.
PATCHPILOT_TIMEOUT_MS=35000
# Whole request, including one bounded retry and one JSON repair.
PATCHPILOT_DEADLINE_MS=45000
# Bearer token required to expose the MCP connector in production.
PATCHPILOT_MCP_TOKEN=